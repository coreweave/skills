# Python build artifacts and caches.
# Note: dist/ is intentionally NOT ignored — it is the published artifact
# (rendered SKILL.md files) and must be committed. CI verifies that the
# committed dist/ matches a fresh build (see .github/workflows/build.yml).

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Packaging
*.egg-info/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
.python-version

# Vendored JS dependencies. Nothing in this repo installs them today;
# the entry exists so every cache directory the eval hygiene scanner
# exempts (SKIP_DIRNAMES in evals/check_eval_hygiene.py) is genuinely
# un-committable. scripts/test_eval_hygiene.py asserts that pairing.
node_modules/

# Editor / OS scratch files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local-only build scratch space.
# The build script may write transient files here; the final published
# artifact lives in dist/ and IS committed.
.build-cache/

# Runtime skill config — written by the interview pattern at first run,
# contains environment-specific values (tool versions, env var names).
# Each user/machine generates their own; never commit.
.skillconfig/

# Local Claude Code state (settings.local.json, worktrees) — machine-specific
# and may contain private configuration; never commit.
.claude/

# Local eval-sweep artifacts (evals/run_trigger_evals.py --out, default
# trigger-results.json). They hold raw model/tool output from a run, so
# they are the least-reviewed content in the tree and must never be
# committed. The hygiene scanner deliberately does NOT exempt them by
# name — delete a local artifact before running the gate rather than
# allowlisting whatever a sweep happened to echo.
trigger-results.json
results-*.json
